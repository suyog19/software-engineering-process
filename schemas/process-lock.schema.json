{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "source", "version", "revision", "manifest_digest", "generated_at"],
  "properties": {
    "schema_version": {"const": 1}, "source": {"type": "string"},
    "version": {"type": "string"}, "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "generated_files": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
