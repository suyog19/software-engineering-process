{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "additionalProperties": false,
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": {"const": "https://in-toto.io/Statement/v1"},
    "subject": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "required": ["name", "digest"], "properties": {"name": {"type": "string"}, "digest": {"type": "object", "required": ["gitCommit"], "properties": {"gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}}}},
    "predicateType": {"type": "string", "pattern": "^https://suyogjoshi.com/software-signal/engineering/.+/v[12]$"},
    "predicate": {"type": "object", "required": ["processVersion", "processRevision", "capability", "verdict", "issuedAt", "producer"], "properties": {
      "processVersion": {"type": "string"}, "processRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
      "capability": {"type": "string"}, "verdict": {"enum": ["pass", "fail", "approved", "sufficient"]},
      "issuedAt": {"type": "string", "format": "date-time"},
      "producer": {"type": "object", "required": ["identity", "contextId"], "properties": {"identity": {"type": "string"}, "contextId": {"type": "string"}, "implementationContextId": {"type": ["string", "null"]}, "freshContext": {"type": "boolean"}}},
      "findings": {"type": "array"}, "residualRisk": {"type": "array"}
    }}
  }
}
